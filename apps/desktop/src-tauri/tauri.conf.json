{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CentroColor",
  "version": "0.1.0",
  "identifier": "com.centrocolor.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CentroColor",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": { "sql": { "preload": ["sqlite:centrocolor.db"] } },
  "bundle": { "active": true, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
