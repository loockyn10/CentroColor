{
  "name": "centrocolor",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev:web": "pnpm --filter @centrocolor/web dev",
    "dev:desktop": "pnpm --filter @centrocolor/desktop tauri dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @centrocolor/desktop tauri build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "supabase": "^2.117.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
